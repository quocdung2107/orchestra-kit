#!/usr/bin/env python
"""Stop hook: blocks finishing when the session opened an S-ID whose handoff is not valid.

Equivalent to `orc validate --handoff --key <session_id>`. No-op without
.orchestra/ or when the session opened no S-ID.
"""
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "cli"))


def main() -> int:
    try:
        data = json.loads(sys.stdin.read() or "{}")
    except Exception:
        return 0
    try:
        import orc_core
        if orc_core.legacy_hook_shadowed(data.get("cwd") or "."):
            return 0  # bridge: the project enabled the orchestra plugin, which runs its own hooks
        root = orc_core.find_root(data.get("cwd") or ".")
        if root is None:
            return 0
        decision = orc_core.stop_check(root, data.get("session_id"))
    except Exception as exc:  # a kit error must never lock the session
        print(f"[orchestra] stop_check error, ignored: {exc}", file=sys.stderr)
        return 0
    if decision:
        print(json.dumps(decision, ensure_ascii=True))
    return 0


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env python
"""UserPromptSubmit hook: records evidence of the user's prompts in `.orchestra/runtime/prompts.jsonl`.

Per prompt: ts, session_id, sha256 of the full text, and verbatim only the `orc:<command> ...` lines (orc:approve, orc:resume,
orc:downgrade). The `prev` hash chain detects edits/deletions of old lines. Never blocks; no-op without .orchestra/.
Limitation: a process running as the same user can still append valid lines to this file — the hash chain detects edits, not appends.
"""
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "cli"))


def main() -> int:
    raw = ""
    try:
        raw = sys.stdin.buffer.read().decode("utf-8")
        payload = json.loads(raw or "{}")
        import orc_guard  # stdlib only
        orc_guard.log_prompt(payload)
    except Exception as exc:  # never break the session
        print(f"[orchestra] prompt_log error: {exc}", file=sys.stderr)
        try:  # record the error so the shadow report can count it (never break the session)
            import datetime, os
            d = os.path.join(json.loads(raw or "{}").get("cwd") or ".", ".orchestra", "runtime")
            if os.path.isdir(d):
                with open(os.path.join(d, "hook-errors.jsonl"), "a", encoding="utf-8") as f:
                    f.write(json.dumps({"ts": datetime.datetime.now().isoformat(timespec="seconds"),
                                        "hook": "prompt_log", "error": str(exc)[:300]}, ensure_ascii=False) + "\n")
        except Exception:
            pass
    return 0


if __name__ == "__main__":
    sys.exit(main())

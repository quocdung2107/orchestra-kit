#!/usr/bin/env python
"""PreToolUse hook: guard driven by task state. Currently SHADOW — always allows, only writes
`.orchestra/runtime/guard-shadow.jsonl`. No-op without .orchestra/.

An enforcing mode will block with exit 2 and fail closed on errors; the escape hatch will then be ORC_SAFE_MODE=1
(only the kit + orchestra config may be edited), with no shortcut to turn the guard off.
"""
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "cli"))


def main() -> int:
    raw = ""
    try:
        raw = sys.stdin.buffer.read().decode("utf-8")
        payload = json.loads(raw or "{}")
        import orc_guard  # stdlib only
        orc_guard.shadow(payload)
    except Exception as exc:  # shadow: never break the session
        print(f"[orchestra] guard shadow error: {exc}", file=sys.stderr)
        try:  # record the error so the shadow report can count it (never break the session)
            import datetime, os
            d = os.path.join(json.loads(raw or "{}").get("cwd") or ".", ".orchestra", "runtime")
            if os.path.isdir(d):
                with open(os.path.join(d, "hook-errors.jsonl"), "a", encoding="utf-8") as f:
                    f.write(json.dumps({"ts": datetime.datetime.now().isoformat(timespec="seconds"),
                                        "hook": "guard", "error": str(exc)[:300]}, ensure_ascii=False) + "\n")
        except Exception:
            pass
    return 0


if __name__ == "__main__":
    sys.exit(main())

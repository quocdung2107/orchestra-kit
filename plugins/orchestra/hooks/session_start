#!/usr/bin/env python
"""SessionStart hook: loads `orc brief` into the context. No-op without .orchestra/."""
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "cli"))


def main() -> int:
    try:
        data = json.loads(sys.stdin.read() or "{}")
    except Exception:
        data = {}
    try:
        import orc_core  # stdlib only at module level; PyYAML is loaded lazily
        if orc_core.legacy_hook_shadowed(data.get("cwd") or "."):
            return 0  # bridge: the project enabled the orchestra plugin, which runs its own hooks
        root = orc_core.find_root(data.get("cwd") or ".")
        if root is None:
            return 0
        text = orc_core.brief_text(root, key=data.get("session_id"))
    except Exception as exc:  # never break the session
        text = f"[orchestra] Could not build the brief: {exc}"
    # ensure_ascii: avoids encoding errors on Windows consoles
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "SessionStart",
                                             "additionalContext": text}}, ensure_ascii=True))
    return 0


if __name__ == "__main__":
    sys.exit(main())

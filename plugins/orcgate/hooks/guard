#!/usr/bin/env python
"""PreToolUse hook: guard driven by task state. Every decision is logged to
`.orchestra/runtime/guard-shadow.jsonl` (shadow). Only the rules the project turned on in `guard.enforce`
(edit_write, git_push) block the tool: exit 2 with the reason on stderr, which Claude Code shows to the model.
No-op without .orchestra/. Escape hatch: ORC_SAFE_MODE=1 (only the kit + orchestra config may be edited).
"""
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "cli"))


def main() -> int:
    raw = ""
    try:
        raw = sys.stdin.buffer.read().decode("utf-8")
        payload = json.loads(raw or "{}")
        import orc_guard  # stdlib only
        rec = orc_guard.shadow(payload)
        if rec and rec.get("enforced"):
            print(f"[orcgate guard] blocked: {rec['enforced']}", file=sys.stderr)
            return 2
    except Exception as exc:  # shadow: never break the session
        print(f"[orcgate] guard shadow error: {exc}", file=sys.stderr)
        try:  # record the error so the shadow report can count it (never break the session)
            import datetime, os
            d = os.path.join(json.loads(raw or "{}").get("cwd") or ".", ".orchestra", "runtime")
            if os.path.isdir(d):
                with open(os.path.join(d, "hook-errors.jsonl"), "a", encoding="utf-8") as f:
                    f.write(json.dumps({"ts": datetime.datetime.now().isoformat(timespec="seconds"),
                                        "hook": "guard", "error": str(exc)[:300]}, ensure_ascii=False) + "\n")
        except Exception:
            pass
    return 0


if __name__ == "__main__":
    sys.exit(main())

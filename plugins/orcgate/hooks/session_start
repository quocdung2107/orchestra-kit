#!/usr/bin/env python
"""SessionStart hook: loads `orc brief` into the context. No-op without .orchestra/."""
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "cli"))


def put_plugin_orc_first() -> None:
    """Claude Code appends the plugin bin/ to PATH, so an older `orc` earlier on PATH would win. SessionStart may add
    `export` lines to $CLAUDE_ENV_FILE, which the Bash tool runs before each command: put our bin/ first."""
    env_file = os.environ.get("CLAUDE_ENV_FILE")
    if not env_file:
        return
    try:
        import orc_core
        line = orc_core.path_first_line(Path(__file__).resolve().parent.parent / "bin")
        with open(env_file, "a", encoding="utf-8", newline="\n") as fh:
            fh.write(line + "\n")
    except Exception:
        pass  # never break the session


def main() -> int:
    try:
        data = json.loads(sys.stdin.read() or "{}")
    except Exception:
        data = {}
    try:
        import orc_core  # stdlib only at module level; PyYAML is loaded lazily
        if orc_core.legacy_hook_shadowed(data.get("cwd") or "."):
            return 0  # bridge: the project enabled the orchestra plugin, which runs its own hooks
        root = orc_core.find_root(data.get("cwd") or ".")
        if root is None:
            return 0
        text = orc_core.brief_text(root, key=data.get("session_id"))
        put_plugin_orc_first()
    except Exception as exc:  # never break the session
        text = f"[orcgate] Could not build the brief: {exc}"
    # ensure_ascii: avoids encoding errors on Windows consoles
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "SessionStart",
                                             "additionalContext": text}}, ensure_ascii=True))
    return 0


if __name__ == "__main__":
    sys.exit(main())
